[
  {
    "no": 1,
    "n": "01",
    "short": "பூரணத்துவம் மலரட்டும்",
    "full": "பூரணத்துவம் மலரட்டும்",
    "file": "01_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/01_ta-IN-ValluvarNeural.mp3",
    "poem": "பூரணத்துவம் மலரட்டும்\nபூரணமான இருளில் பூரணமடைய புதிய பாதை தேடி பூரணமான ஒளியால் பூரணமாக படைக்கப்பட்டு தாயின் கருப்பையில் பூரணமாக வளர்ந்து கர்ப்பக்காலம் பூரணமடைவதில் பூரண கனவுகளால் நிறைந்து பூமியில் நானுதித்தேன் மழலை என்ற பூரணத்துவமாய்.\n\nதொப்புள் கொடி அறுந்ததுமே தலைகீழாய் பிடிக்கப்பட்டேன், இனி வாழ்க்கையும் அப்படியே அமையப் போகிறது என்று அப்போது நானறியவில்லை.\n\nவளர வளர தேய்ந்தது பூரணத்துவம்."
  },
  {
    "no": 2,
    "n": "02",
    "short": "என்ன செய்தேன்?",
    "full": "என்ன செய்தேன்?",
    "file": "02_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/02_ta-IN-ValluvarNeural.mp3",
    "poem": "என்ன செய்தேன்?\nஎன்ன செய்தேன் என்னால் செய்ய முடிந்தவற்றால்?\nஎன்ன செய்தேன் என் வாழ்க்கையுடன்?"
  },
  {
    "no": 3,
    "n": "03",
    "short": "வாழ்ந்து காட்டு",
    "full": "வாழ்ந்து காட்டு",
    "file": "03_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/03_ta-IN-ValluvarNeural.mp3",
    "poem": "வாழ்ந்து காட்டு\nநான் புத்தகங்களை வாசிப்பதில் என் நேரங்களைக் கழிக்கிறேன் என்றேன்."
  },
  {
    "no": 4,
    "n": "04",
    "short": "எனது வேண்டுதல்",
    "full": "எனது வேண்டுதல்",
    "file": "04_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/04_ta-IN-ValluvarNeural.mp3",
    "poem": "எனது வேண்டுதல்\nமனிதர்களிடம் பேசி மனிதர்களோடு மகிழ்ச்சியாக வாழ விரும்பினேன் நான்."
  },
  {
    "no": 5,
    "n": "05",
    "short": "சீவ கீதம்",
    "full": "சீவ கீதம்",
    "file": "05_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/05_ta-IN-ValluvarNeural.mp3",
    "poem": "சீவ கீதம்\nபசி என்று ஓடி வந்தேன் பக்திமான் நீ ஏதாவது சாப்பிட கொடுப்பாய் என்று நம்பி."
  },
  {
    "no": 6,
    "n": "06",
    "short": "இருளே நிரந்தரமா?",
    "full": "இருளே நிரந்தரமா?",
    "file": "06_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/06_ta-IN-ValluvarNeural.mp3",
    "poem": "இருளே நிரந்தரமா?\nஒளி வருமா?\nஇருளே நிரந்தரமா?"
  },
  {
    "no": 7,
    "n": "07",
    "short": "செய் அல்லது செத்துமடி",
    "full": "செய் அல்லது செத்துமடி",
    "file": "07_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/07_ta-IN-ValluvarNeural.mp3",
    "poem": "செய் அல்லது செத்துமடி\nசலிப்பான வாழ்வில் சும்மா இருந்து சலித்துப்போகவில்லையா?"
  },
  {
    "no": 8,
    "n": "08",
    "short": "ஓ, மனமே",
    "full": "ஓ, மனமே",
    "file": "08_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/08_ta-IN-ValluvarNeural.mp3",
    "poem": "ஓ, மனமே\nசித்தம் இனிக்க சிவமே செந்தமிழில் ஒரு பாட்டு சொல்லு"
  },
  {
    "no": 9,
    "n": "09",
    "short": "இதுவரை என்னை வென்றது யார்?",
    "full": "இதுவரை என்னை வென்றது யார்?",
    "file": "09_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/09_ta-IN-ValluvarNeural.mp3",
    "poem": "இதுவரை என்னை வென்றது யார்?\nகடவுளுக்கும் எனக்கும் ஒரு போட்டி."
  },
  {
    "no": 10,
    "n": "10",
    "short": "பொய்மை விட்டே விலகிடு",
    "full": "பொய்மை விட்டே விலகிடு",
    "file": "10_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/10_ta-IN-ValluvarNeural.mp3",
    "poem": "பொய்மை விட்டே விலகிடு\nபொய்மையை விலகிடு"
  },
  {
    "no": 11,
    "n": "11",
    "short": "உயிர் பெறு மனமே",
    "full": "உயிர் பெறு மனமே",
    "file": "11_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/11_ta-IN-ValluvarNeural.mp3",
    "poem": "உயிர் பெறு மனமே\nகிளியொன்றை கூண்டுல தான் அடைச்சு வைச்சேன்"
  },
  {
    "no": 12,
    "n": "12",
    "short": "கண்டபடி அலையாதே",
    "full": "கண்டபடி அலையாதே",
    "file": "12_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/12_ta-IN-ValluvarNeural.mp3",
    "poem": "கண்டபடி அலையாதே\nஅன்றொரு நாள் இதே கனவில் உன்னை வெட்டி கொலை செய்தேன்"
  },
  {
    "no": 13,
    "n": "13",
    "short": "சத்தியம் செய்வீர்களாக",
    "full": "சத்தியம் செய்வீர்களாக",
    "file": "13_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/13_ta-IN-ValluvarNeural.mp3",
    "poem": "சத்தியம் செய்வீர்களாக\nஎன் மனதில் தப்பான எண்ணம் இருந்தது இல்லை"
  },
  {
    "no": 14,
    "n": "14",
    "short": "அதை ஏன்பா கேட்குற?!",
    "full": "அதை ஏன்பா கேட்குற?!",
    "file": "14_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/14_ta-IN-ValluvarNeural.mp3",
    "poem": "அதை ஏன்பா கேட்குற?!\nஉன்னை விட்டால் யாருமில்லை எனக்கு!"
  },
  {
    "no": 15,
    "n": "15",
    "short": "அந்த ஞானி ஒரு பச்சோந்தி",
    "full": "அந்த ஞானி ஒரு பச்சோந்தி பா",
    "file": "15_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/15_ta-IN-ValluvarNeural.mp3",
    "poem": "அந்த ஞானி ஒரு பச்சோந்தி பா\nகாதல் என்று சொன்னால் கல்லாலேயே அடிப்பேன்னு"
  },
  {
    "no": 16,
    "n": "16",
    "short": "வாசமில்லா ரோஜா",
    "full": "வாசமில்லா ரோஜா",
    "file": "16_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/16_ta-IN-ValluvarNeural.mp3",
    "poem": "வாசமில்லா ரோஜா\nஅடி! வாசமில்லா ரோஜா, உனக்கு ஏதடி ராஜா"
  },
  {
    "no": 17,
    "n": "17",
    "short": "என் இரக்கம்",
    "full": "என் இரக்கம்",
    "file": "17_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/17_ta-IN-ValluvarNeural.mp3",
    "poem": "என் இரக்கம்\nகரையான்களிடம் இரக்கம் காட்டினேன்"
  },
  {
    "no": 18,
    "n": "18",
    "short": "குற்றம் செய்வது யார்",
    "full": "குற்றம் செய்வது யார்",
    "file": "18_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/18_ta-IN-ValluvarNeural.mp3",
    "poem": "குற்றம் செய்வது யார்\nபாரப்பா பழனியப்பா!"
  },
  {
    "no": 19,
    "n": "19",
    "short": "திட்டித் தீர்க்கும் முன்",
    "full": "திட்டித் தீர்க்கும் முன்",
    "file": "19_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/19_ta-IN-ValluvarNeural.mp3",
    "poem": "திட்டித் தீர்க்கும் முன்\nகுரங்குகளை வைத்து வித்தைகாட்ட"
  },
  {
    "no": 20,
    "n": "20",
    "short": "இது தான் நிரந்தர தீர்வு",
    "full": "இது தான் நிரந்தர தீர்வு",
    "file": "20_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/20_ta-IN-ValluvarNeural.mp3",
    "poem": "இது தான் நிரந்தர தீர்வு\nஇந்த சமூகத்தில் அதிகரிக்கும் ஒழுக்கமின்மை"
  },
  {
    "no": 21,
    "n": "21",
    "short": "ஒரு மனசாட்சியின் அறிக்கை",
    "full": "ஒரு மனசாட்சியின் அறிக்கை",
    "file": "21_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/21_ta-IN-ValluvarNeural.mp3",
    "poem": "ஒரு மனசாட்சியின் அறிக்கை\nஅரசியல்வாதிகளே!"
  },
  {
    "no": 22,
    "n": "22",
    "short": "அரக்கன் வருகிறான்",
    "full": "அரக்கன் வருகிறான்",
    "file": "22_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/22_ta-IN-ValluvarNeural.mp3",
    "poem": "அரக்கன் வருகிறான்\nகாயாத கானகத்தே"
  },
  {
    "no": 23,
    "n": "23",
    "short": "தைரியம் கொள்ளுங்கள்",
    "full": "தைரியம் கொள்ளுங்கள்",
    "file": "23_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/23_ta-IN-ValluvarNeural.mp3",
    "poem": "தைரியம் கொள்ளுங்கள்\nபிறந்த எல்லாரும் மரணிக்கப்போவது உறுதி."
  },
  {
    "no": 24,
    "n": "24",
    "short": "தாய்மை",
    "full": "தாய்மை",
    "file": "24_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/24_ta-IN-ValluvarNeural.mp3",
    "poem": "தாய்மை\nஎன்னை பெற்றதும் பாரம் இறங்கியது"
  },
  {
    "no": 25,
    "n": "25",
    "short": "தனியாள்",
    "full": "தனியாள்",
    "file": "25_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/25_ta-IN-ValluvarNeural.mp3",
    "poem": "தனியாள்\nஎங்கு நோக்கிலும் ஆண் பெண் பாலின கவர்ச்சி"
  },
  {
    "no": 26,
    "n": "26",
    "short": "உலக அமைதி என்னும் வார்த்தை",
    "full": "உலக அமைதி என்னும் வார்த்தை ஜாலம்",
    "file": "26_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/26_ta-IN-ValluvarNeural.mp3",
    "poem": "உலக அமைதி என்னும் வார்த்தை ஜாலம்\nஉலக நாடுகளை ஏமாற்றி"
  },
  {
    "no": 27,
    "n": "27",
    "short": "நானெழுதுவேன் என்னுயிர் தமிழால்",
    "full": "நானெழுதுவேன் என்னுயிர் தமிழால்",
    "file": "27_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/27_ta-IN-ValluvarNeural.mp3",
    "poem": "நானெழுதுவேன் என்னுயிர் தமிழால்"
  },
  {
    "no": 28,
    "n": "28",
    "short": "மரியாதை இல்லை",
    "full": "மரியாதை இல்லை",
    "file": "28_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/28_ta-IN-ValluvarNeural.mp3",
    "poem": "மரியாதை இல்லை\nஉழைக்கும் மனிதனுக்கு மரியாதை இல்லை."
  },
  {
    "no": 29,
    "n": "29",
    "short": "பாதகத்தி உன்னை நினைத்து",
    "full": "பாதகத்தி உன்னை நினைத்து",
    "file": "29_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/29_ta-IN-ValluvarNeural.mp3",
    "poem": "பாதகத்தி உன்னை நினைத்து\nபாதகத்தி! உன்னை நினைத்து பாறாங்கல்லா ஆச்சு நெஞ்சு."
  },
  {
    "no": 30,
    "n": "30",
    "short": "நானாகிய நான்",
    "full": "நானாகிய நான்",
    "file": "30_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/30_ta-IN-ValluvarNeural.mp3",
    "poem": "நானாகிய நான்\nநானாகிய உலகை நானாகிய நான் படைத்து"
  },
  {
    "no": 31,
    "n": "31",
    "short": "இன்பமும் துன்பமும்",
    "full": "இன்பமும் துன்பமும்",
    "file": "31_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/31_ta-IN-ValluvarNeural.mp3",
    "poem": "இன்பமும் துன்பமும்\nஇன்பம் வேண்டுவார் துன்பம் வேண்டாப்பெறுவர்"
  },
  {
    "no": 32,
    "n": "32",
    "short": "தன்னில் நிறைதல்",
    "full": "தன்னில் நிறைதல்",
    "file": "32_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/32_ta-IN-ValluvarNeural.mp3",
    "poem": "தன்னில் நிறைதல்\nவேற்றுமை கண்டார் வெதும்பி நின்றார்"
  },
  {
    "no": 33,
    "n": "33",
    "short": "தலைவன் ஒருவனே",
    "full": "தலைவன் ஒருவனே",
    "file": "33_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/33_ta-IN-ValluvarNeural.mp3",
    "poem": "தலைவன் ஒருவனே\nகண்கள் முடங்கினால் பார்ப்பது எப்படி?"
  },
  {
    "no": 34,
    "n": "34",
    "short": "மரணம் போதித்த வாழ்க்கை",
    "full": "மரணம் போதித்த வாழ்க்கை",
    "file": "34_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/34_ta-IN-ValluvarNeural.mp3",
    "poem": "மரணம் போதித்த வாழ்க்கை\nவாழ வேண்டாதார் வாழுதலும்"
  },
  {
    "no": 35,
    "n": "35",
    "short": "விஷம் முறிந்திட",
    "full": "விஷம் முறிந்திட",
    "file": "35_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/35_ta-IN-ValluvarNeural.mp3",
    "poem": "விஷம் முறிந்திட\nபெருந்நோய் தீண்டாத வாழ்வே"
  },
  {
    "no": 36,
    "n": "36",
    "short": "ஆராய்ந்து பார்த்தால் ஒன்னுமில்லே",
    "full": "ஆராய்ந்து பார்த்தால் ஒன்னுமில்லே",
    "file": "36_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/36_ta-IN-ValluvarNeural.mp3",
    "poem": "ஆராய்ந்து பார்த்தால் ஒன்னுமில்லே\nமனிதன் ஆடி அடங்குவது மண்ணுக்குள்ளே!"
  },
  {
    "no": 37,
    "n": "37",
    "short": "என் மரணத்தை நோக்கி",
    "full": "என் மரணத்தை நோக்கி",
    "file": "37_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/37_ta-IN-ValluvarNeural.mp3",
    "poem": "என் மரணத்தை நோக்கி\nபொருளில் ஈடுபாடின்றி"
  },
  {
    "no": 38,
    "n": "38",
    "short": "மாற்றமாய் உருவெடு",
    "full": "மாற்றமாய் உருவெடு",
    "file": "38_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/38_ta-IN-ValluvarNeural.mp3",
    "poem": "மாற்றமாய் உருவெடு\nஎன்னமோ எழுதி வைத்தான் இறைவன்"
  },
  {
    "no": 39,
    "n": "39",
    "short": "அட என்னாச்சு, உலகம் மாறியாச்சு",
    "full": "அட என்னாச்சு, உலகம் மாறியாச்சு",
    "file": "39_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/39_ta-IN-ValluvarNeural.mp3",
    "poem": "அட என்னாச்சு, உலகம் மாறியாச்சு\nமனிதன் படைச்சு வச்ச காசு"
  },
  {
    "no": 40,
    "n": "40",
    "short": "உதவாக்கரை எழுத்தாளாகிய என்னை பற்றி",
    "full": "உதவாக்கரை எழுத்தாளாகிய என்னை பற்றி",
    "file": "40_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/40_ta-IN-ValluvarNeural.mp3",
    "poem": "உதவாக்கரை எழுத்தாளாகிய என்னை பற்றி"
  },
  {
    "no": 41,
    "n": "41",
    "short": "உலகச் சிந்தனை",
    "full": "உலகச் சிந்தனை",
    "file": "41_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/41_ta-IN-ValluvarNeural.mp3",
    "poem": "உலகச் சிந்தனை\nஇந்த உலகைப் பற்றி என்ன தெரியும் உனக்கு?"
  },
  {
    "no": 42,
    "n": "42",
    "short": "மனித சாத்தானால் உருவான இரத்த",
    "full": "மனித சாத்தானால் உருவான இரத்த ஆறு",
    "file": "42_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/42_ta-IN-ValluvarNeural.mp3",
    "poem": "மனித சாத்தானால் உருவான இரத்த ஆறு\nஅன்பில்லா மனம் உயிரில்லா பிணமாய்"
  },
  {
    "no": 43,
    "n": "43",
    "short": "தருவாயாக",
    "full": "தருவாயாக",
    "file": "43_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/43_ta-IN-ValluvarNeural.mp3",
    "poem": "தருவாயாக\nகடற்கரையில் புதைத்த பிணம் எழுந்து"
  },
  {
    "no": 44,
    "n": "44",
    "short": "அலைகள் உணர்த்திய மெஞ்ஞானம்",
    "full": "அலைகள் உணர்த்திய மெஞ்ஞானம்",
    "file": "44_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/44_ta-IN-ValluvarNeural.mp3",
    "poem": "அலைகள் உணர்த்திய மெஞ்ஞானம்\nதவமிருந்து பெற்ற ஞானம்"
  },
  {
    "no": 45,
    "n": "45",
    "short": "தனிமை",
    "full": "தனிமை",
    "file": "45_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/45_ta-IN-ValluvarNeural.mp3",
    "poem": "தனிமை\nஇனிது இனிது ஏகாந்தம் இனிது"
  },
  {
    "no": 46,
    "n": "46",
    "short": "முள்ளுக்காட்டு இதிகாசம்",
    "full": "முள்ளுக்காட்டு இதிகாசம்",
    "file": "46_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/46_ta-IN-ValluvarNeural.mp3",
    "poem": "முள்ளுக்காட்டு இதிகாசம்\nசிவந்த உள்ளங்கால்கள்"
  },
  {
    "no": 47,
    "n": "47",
    "short": "மனித இனத்தின் வீழ்ச்சி",
    "full": "மனித இனத்தின் வீழ்ச்சி",
    "file": "47_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/47_ta-IN-ValluvarNeural.mp3",
    "poem": "மனித இனத்தின் வீழ்ச்சி\nஊன மனத்தாரே!"
  },
  {
    "no": 48,
    "n": "48",
    "short": "திசை திரும்பாதிருக்க வேண்டும்",
    "full": "திசை திரும்பாதிருக்க வேண்டும்",
    "file": "48_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/48_ta-IN-ValluvarNeural.mp3",
    "poem": "திசை திரும்பாதிருக்க வேண்டும்\nகடவுளைக் காணும் கண்களுக்கு கோவில்கள் தெரியாது."
  },
  {
    "no": 49,
    "n": "49",
    "short": "எதை நோக்கி பயணிக்கிறோம்?",
    "full": "எதை நோக்கி பயணிக்கிறோம்?",
    "file": "49_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/49_ta-IN-ValluvarNeural.mp3",
    "poem": "எதை நோக்கி பயணிக்கிறோம்?\nஏலோ பாடும் கிராமத் தென்றலில்"
  },
  {
    "no": 50,
    "n": "50",
    "short": "உயிர்த்துடிப்பு",
    "full": "உயிர்த்துடிப்பு",
    "file": "50_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/50_ta-IN-ValluvarNeural.mp3",
    "poem": "உயிர்த்துடிப்பு\nஇலைகளை எல்லாம் உதிர்த்துவிட்டு"
  },
  {
    "no": 51,
    "n": "51",
    "short": "லட்சியத்தை நோக்கி",
    "full": "லட்சியத்தை நோக்கி",
    "file": "51_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/51_ta-IN-ValluvarNeural.mp3",
    "poem": "லட்சியத்தை நோக்கி\nஎனக்கு பயமாக இல்லை முதல்படியை ஏறிய போது."
  },
  {
    "no": 52,
    "n": "52",
    "short": "அடுத்த கட்டம்",
    "full": "அடுத்த கட்டம்",
    "file": "52_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/52_ta-IN-ValluvarNeural.mp3",
    "poem": "அடுத்த கட்டம்\nஅதே நிலையில் இருக்கிறோம்"
  },
  {
    "no": 53,
    "n": "53",
    "short": "விவசாயம் செய்வோம்",
    "full": "விவசாயம் செய்வோம்",
    "file": "53_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/53_ta-IN-ValluvarNeural.mp3",
    "poem": "விவசாயம் செய்வோம்\nசும்மா போகிற தண்ணிய கரை கட்டி"
  },
  {
    "no": 54,
    "n": "54",
    "short": "புனித தீயாடல்",
    "full": "புனித தீயாடல்",
    "file": "54_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/54_ta-IN-ValluvarNeural.mp3",
    "poem": "புனித தீயாடல்\nஅமைதியான பனி மலையல்ல"
  },
  {
    "no": 55,
    "n": "55",
    "short": "இரக்கமென்னும் தீயில் வேகுது மனமே",
    "full": "இரக்கமென்னும் தீயில் வேகுது மனமே",
    "file": "55_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/55_ta-IN-ValluvarNeural.mp3",
    "poem": "இரக்கமென்னும் தீயில் வேகுது மனமே\nமாலை மங்கி இருள் சூழ்ந்த நேரம்"
  },
  {
    "no": 56,
    "n": "56",
    "short": "அதை செய்ய முடியாது, ஆனால்",
    "full": "அதை செய்ய முடியாது, ஆனால் முடியும்",
    "file": "56_ta-IN-ValluvarNeural.mp3",
    "src": "./audio/56_ta-IN-ValluvarNeural.mp3",
    "poem": "அதை செய்ய முடியாது, ஆனால் முடியும்\nயாரோ ஒருவர் சொன்னார், அதை செய்ய முடியாது என்று."
  }
]
